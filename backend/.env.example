# Copy to .env and adjust. Every key is optional in development.
ENV=development
# Required when ENV=production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Origins allowed to call the API directly (the web app uses the same-origin /api proxy).
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app, printed as a QR on PDF reports.
PUBLIC_APP_URL=http://localhost:3000
# Create the demo merchant (merchant@pramaan.local / shopkeeper123) and sample history on first start.
SEED_DEMO_DATA=true
RETENTION_HOURS=24
